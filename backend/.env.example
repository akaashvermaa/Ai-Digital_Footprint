# Template of the settings the backend reads from ENVIRONMENT VARIABLES.
# The backend does not read this file by itself: set these in your shell or hosting dashboard.
# Never put real secrets in this file; API keys (if ever added) belong in the environment, not in code.

# Frontend origins allowed to call this API (comma separated). Use your real https:// URL when deployed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Analyses allowed per minute per client IP (each one contacts 62 third-party sites)
RATE_LIMIT_PER_MIN=10
