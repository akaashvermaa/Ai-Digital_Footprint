# Copy to .env and edit. Never commit real secrets; API keys (if ever added) belong here, not in code.

# Frontend origins allowed to call this API (comma separated). Use your real https:// URL when deployed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Analyses allowed per minute per client IP (each one contacts ~24 third-party sites)
RATE_LIMIT_PER_MIN=10
